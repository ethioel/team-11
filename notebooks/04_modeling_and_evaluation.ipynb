   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "sys.path.insert(0, str(Path('.').resolve().parent / 'src'))\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from train import build_model_data, build_preprocessor, fit_and_eval\n",
    "\n",
    "PROCESSED_DIR = Path('../data/processed')\n",
    "REPORTS_DIR = Path('../reports')\n",
    "FIGURES_DIR = Path('../figures')\n",
    "\n",
    "# Load processed data\n",
    "train_df = pd.read_csv(PROCESSED_DIR / 'master_train.csv')\n",
    "test_df = pd.read_csv(PROCESSED_DIR / 'master_test.csv')\n",
    "\n",
    "print(f'Train: {train_df.shape}')\n",
    "print(f'Test: {test_df.shape}')\n",
    "print(f'Features: {len(train_df.columns)}')"
   ]
  },
  {
   "cell_type": "code_cell",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build model data\n",
    "feature_cols = build_feature_columns()\n",
    "train_data = build_model_data(train_df, feature_cols)\n",
    "test_data = build_model_data(test_df, feature_cols)\n",
    "\n",
    "print(f'\\nTraining data shape: {train_data.X.shape}')\n",
    "print(f'Test data shape: {test_data.X.shape}')\n",
    "print(f'Feature columns: {len(feature_cols)}')"
   ]
  },
  {
   "cell_type": "code_cell",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fit and evaluate all models\n",
    "results = fit_and_eval(train_data, test_data)\n",
    "\n",
    "print(\"\\nModel Results:\")\n",
    "for model_name, metrics in results.items():\n",
    "    print(f'  {model_name}: RMSE={metrics[\\'rmse\\']:.4f}, R²={metrics[\\'r2\\']:.4f}')"
   ]
  },
  {
   "cell_type": "code_cell",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display best model metrics\n",
    "best_model = min(results.items(), key=lambda x: x[1]['rmse'])\n",
    "print(f'\\nBest Model: {best_model[0]}')\n",
    "print(f'  RMSE: {best_model[1][\\'rmse\\']:.4f}')\n",
    "print(f'  R²: {best_model[1][\\'r2\\']:.4f}')\n",
    "print(f'  MAE: {best_model[1][\\'mae\\']:.4f}')"
   ]
  },
  {
   "cell_type": "code_cell",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load model comparison CSV\n",
    "comp_df = pd.read_csv(REPORTS_DIR / 'D_model_comparison.csv')\n",
    "\n",
    "print(\"\\nModel Comparison:\")\n",
    "print(comp_df.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code_cell",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot model comparison\n",
    "plt.figure(figsize=(14, 8))\n",
    "plot_df = comp_df.head(15)\n",
    "sns.barplot(data=plot_df, x='model', y='rmse', hue='model', palette='Set2', legend=False)\n",
    "plt.title('Model comparison (validation RMSE)')\n",
    "plt.ylabel('RMSE')\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / 'fig10_model_comparison.png', dpi=150)\n",
    "plt.close()\n",
    "print('✓ Model comparison plot saved')"
   ]
  }
